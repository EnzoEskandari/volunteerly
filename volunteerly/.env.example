# ─────────────────────────────────────────────────────────────────────────
# Volunteerly environment configuration
#
# Copy this file to .env.local and fill in real values. Volunteerly talks
# to a real, shared, multi-user database — there is no offline or mock
# mode, so the app will not start without Supabase credentials.
#
# In production, set these in your host's environment variables (e.g.
# Vercel → Project Settings → Environment Variables). Never commit .env.local.
# ─────────────────────────────────────────────────────────────────────────

# ── Supabase (required) ──────────────────────────────────────────────────
# Project Settings → API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses row-level security and is used by the API routes to
# write the tables users aren't trusted with (registrations, attendance,
# verified hours, membership). Must never be exposed to the browser —
# note the deliberate absence of a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Google Sign-In ───────────────────────────────────────────────────────
# Configured inside Supabase → Authentication → Providers → Google.
# These are set in the Supabase dashboard, not read by this app directly.

# ── Stripe (required for student memberships) ────────────────────────────
# Students pay a small annual membership. Organizations are never charged.
STRIPE_SECRET_KEY=sk_test_xxx

# From `stripe listen` locally, or the webhook endpoint's signing secret in
# the Stripe dashboard. Membership is granted ONLY by the verified webhook.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Optional but recommended: a recurring Price created in the Stripe
# dashboard. Without it, an inline price is built from the values below.
STRIPE_MEMBERSHIP_PRICE_ID=price_xxx

# ── Membership pricing (configurable, not hardcoded) ─────────────────────
# $5/year is a starting price and may be revisited — change it here rather
# than in code. Stripe remains the billing authority; these drive display
# and the inline fallback price.
NEXT_PUBLIC_MEMBERSHIP_PRICE_CENTS=500
NEXT_PUBLIC_MEMBERSHIP_CURRENCY=usd
NEXT_PUBLIC_MEMBERSHIP_INTERVAL=year

# ── App ──────────────────────────────────────────────────────────────────
# Used for OAuth redirects and Stripe success/cancel URLs. Set this to your
# real deployed origin in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
